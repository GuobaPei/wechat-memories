[
  {"date": "2023-03-04", "end": null, "kind": "大事", "title": "加上微信",
   "text": "社团招新后小鱼加了阿木，两人聊起那只叫土豆的布袋猫。",
   "quotes": [
     {"who": "小鱼", "text": "你好呀，我是社团招新那天坐你旁边的小鱼"},
     {"who": "阿木", "text": "记得记得！你带了一只布袋猫"}
   ]},
  {"date": "2023-03-18", "end": null, "kind": "开心", "title": "爬山",
   "text": "阿木坐过了地铁站，两人还是一起爬到了山顶。小鱼说欠阿木一杯热可可。",
   "quotes": [
     {"who": "阿木", "text": "山顶的风真的好大"},
     {"who": "小鱼", "text": "下次带外套，这次算我欠你一杯热可可"},
     {"who": "阿木", "text": "今天好开心，腿已经不是我的了"},
     {"who": "小鱼", "text": "明天楼梯见"}
   ]},
  {"date": "2023-05-20", "end": "2023-05-21", "kind": "吵架和难过", "title": "迟到的电影",
   "text": "小鱼开组会拖堂，电影开场很久还没到，阿木先回去了。第二天两人说开，约好周末补看。",
   "quotes": [
     {"who": "阿木", "text": "每次都说马上，我真的有点累"},
     {"who": "小鱼", "text": "对不起，是我没提前说"},
     {"who": "阿木", "text": "那这周末补看电影"}
   ]},
  {"date": "2023-07-01", "end": null, "kind": "大事", "title": "拿到实习",
   "text": "小鱼拿到了实习，阿木打来电话，通话 12 分钟，说了什么文字里没写。",
   "quotes": [
     {"who": "小鱼", "text": "我拿到实习了！！！"},
     {"who": "阿木", "text": "太强了！请吃饭！"}
   ]},
  {"date": "2023-08-12", "end": "2023-08-15", "kind": "开心", "title": "大理",
   "text": "两人一起去了大理，阿木带着草帽在洱海边等小鱼。离开前说好下次还来。",
   "quotes": [
     {"who": "小鱼", "text": "飞机落地了，大理的云好低"},
     {"who": "阿木", "text": "今晚的星星我会记很久"},
     {"who": "小鱼", "text": "下次还来"}
   ]},
  {"date": "2023-09-30", "end": null, "kind": "吵架和难过", "title": "老猫走了",
   "text": "深夜阿木说家里的老猫走了，小鱼打了电话过去，两人通话 47 分钟。",
   "quotes": [
     {"who": "阿木", "text": "家里的老猫走了"},
     {"who": "小鱼", "text": "抱抱你，要不要打电话"}
   ]},
  {"date": "2023-10-08", "end": "2023-10-19", "kind": "吵架和难过", "title": "没怎么说话的日子",
   "text": "阿木忙论文，两人没再说话。十一天后阿木先开口道歉，小鱼说自己也没主动。",
   "quotes": [
     {"who": "小鱼", "text": "最近是不是很忙"},
     {"who": "阿木", "text": "这阵子没怎么理你，对不起"},
     {"who": "小鱼", "text": "没事，我也没主动找你"}
   ]},
  {"date": "2023-11-11", "end": null, "kind": "开心", "title": "小鱼的生日",
   "text": "零点阿木卡着点发来祝福，晚上在楼下等小鱼取蛋糕。",
   "quotes": [
     {"who": "阿木", "text": "小鱼生日快乐！"},
     {"who": "小鱼", "text": "你居然卡点了"},
     {"who": "阿木", "text": "楼下取蛋糕"}
   ]},
  {"date": "2023-12-31", "end": "2024-01-01", "kind": "开心", "title": "跨年的约定",
   "text": "跨年前一分钟阿木说明年还要一起爬山，小鱼答应了。",
   "quotes": [
     {"who": "阿木", "text": "明年也要一起爬山"},
     {"who": "小鱼", "text": "说好了，晚安"}
